#!/bin/sh

ENABLED=yes

DESC="Samba AD-DC daemon"
PROCS="samba"
PROG="/opt/sbin/$PROCS"

start_pre() {
  for i in \
    /opt/var/cache/samba \
    /opt/var/lib/samba \
    /opt/var/lock/samba \
    /opt/var/log/samba \
    /opt/var/run/samba
  do
    [ -d "$i" ] || {
      mkdir -pm 0755 "$i"
    }
  done
}

PRECMD="start_pre"
ARGS="-D"
PREARGS=""

. /opt/etc/init.d/rc.func
