#!/bin/sh

ENABLED=yes

DESC="NMB (netbios) daemon"
PROCS="nmbd"
PROG="/opt/sbin/$PROCS"

PID_FILE="/opt/var/run/samba/$PROCS.pid"

start_pre() {
  rm -f "$PID_FILE"
  for i in \
    /opt/var/cache/samba \
    /opt/var/lib/samba \
    /opt/var/lock/samba \
    /opt/var/log/samba \
    /opt/var/run/samba
  do
    [ -d "$i" ] || {
      mkdir -pm 0755 "$i"
    }
  done
}

PRECMD="start_pre"
ARGS="-D"
PREARGS=""

. /opt/etc/init.d/rc.func
